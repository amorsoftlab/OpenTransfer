<Window x:Class="openTransferWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Transfer" Icon="Assets/logo.ico" Height="700" Width="920"
        MinHeight="500" MinWidth="720"
        FontFamily="Inter, Segoe UI, sans-serif"
        Foreground="{DynamicResource FluxOnSurface}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ItemsPanel for Tile Grid View -->
        <ItemsPanelTemplate x:Key="WrapItemsPanel">
            <WrapPanel Width="{Binding (FrameworkElement.ActualWidth), RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"/>
        </ItemsPanelTemplate>

        <!-- ItemsPanel for List View -->
        <ItemsPanelTemplate x:Key="DefaultItemsPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <!-- Tile DataTemplate for Grid View -->
        <DataTemplate x:Key="TileItemTemplate">
            <Border Width="115" Height="110" Margin="5" Padding="6" CornerRadius="8"
                    Background="{DynamicResource FluxSurfaceContainerLowest}"
                    BorderBrush="{DynamicResource FluxOutlineVariant}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Large Tile Icon -->
                    <ContentControl Grid.Row="0" Content="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Icon}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDir}" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid Width="42" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="M 2.5 3 C 2.5 2.2 3.2 1.5 4.5 1.5 L 12.5 1.5 C 13.8 1.5 14.5 2.2 15.5 3.2 L 17 5 L 33 5 C 34.5 5 35.5 6 35.5 7.5 L 35.5 27 C 35.5 28.5 34.5 29.5 33 29.5 L 4.5 29.5 C 3 29.5 2.5 28.5 2.5 27 Z" Fill="{Binding FolderBrush}" Opacity="0.72"/>
                                                        <Path Data="M 1 7 C 1 6 2 5 3.8 5 L 34.2 5 C 36 5 37 6 37 7 L 34.8 26 C 34.4 27.5 32.8 29 31 29 L 7 29 C 5.2 29 3.6 27.5 3.2 26 Z" Fill="{Binding FolderBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- Filename -->
                    <TextBlock Grid.Row="1" Text="{Binding DisplayName}" Style="{DynamicResource FluxBodySm}"
                               FontWeight="SemiBold" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,4,0,2"/>

                    <!-- Size -->
                    <TextBlock Grid.Row="2" Text="{Binding FormattedSize}" FontSize="10"
                               Foreground="{DynamicResource FluxOutline}" TextAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Settings Sidebar Tab Button Style with Green Hover -->
        <Style x:Key="SettingsTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FluxOnSurface}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource FluxPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FluxOnPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme-aware replacement for the Windows native ComboBox chrome. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource FluxOnSurface}"/>
            <Setter Property="Background" Value="{DynamicResource FluxSurfaceContainerLowest}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FluxSurfaceContainerHigh}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FluxPrimary}"/>
                    <Setter Property="Foreground" Value="{DynamicResource FluxOnPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource FluxOnSurface}"/>
            <Setter Property="Background" Value="{DynamicResource FluxSurfaceContainerLowest}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FluxOutlineVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="8,2" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                      StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,3,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320" Background="{DynamicResource FluxSurfaceContainerLowest}"
                                        BorderBrush="{DynamicResource FluxOutlineVariant}" BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FluxPrimary}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.58"/>
                                <Setter Property="Background" Value="{DynamicResource FluxSurfaceContainer}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR: Navigation, Location Path Pill & Search -->
        <Border Grid.Row="0" Padding="14,10" Background="{DynamicResource FluxSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Arrows ← → ↑ -->
                <Button Grid.Column="0" Content="←" Style="{DynamicResource FluxNavButton}" Click="BtnBack_Click" ToolTip="Back" Margin="0,0,2,0"/>
                <Button Grid.Column="1" Content="→" Style="{DynamicResource FluxNavButton}" Click="BtnForward_Click" ToolTip="Forward" Margin="0,0,2,0"/>
                <Button Grid.Column="2" Content="↑" Style="{DynamicResource FluxNavButton}" Click="BtnUp_Click" ToolTip="Parent Folder" Margin="0,0,10,0"/>

                <!-- Location Path Pill Bar (Matching Target UI Screenshot) -->
                <Border Grid.Column="3" Background="{DynamicResource FluxSurfaceContainer}"
                        CornerRadius="{DynamicResource FluxRadiusXl}" Padding="12,4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📱" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="BtnRootFolder_Click" ToolTip="Go to root folder"/>
                        <ComboBox Grid.Column="1" x:Name="CmbDevices" SelectionChanged="CmbDevices_SelectionChanged"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Serial"
                                  BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                  FontFamily="Inter, Segoe UI, sans-serif" FontSize="13" FontWeight="Bold"
                                  Foreground="{DynamicResource FluxOnSurface}" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="2" x:Name="CmbStorageRoots" SelectionChanged="CmbStorageRoots_SelectionChanged"
                                  BorderThickness="0" Background="Transparent" MinWidth="90" Margin="0,0,8,0"
                                  Foreground="{DynamicResource FluxOnSurfaceVariant}" ToolTip="Storage location"/>
                        <TextBox Grid.Column="3" x:Name="TxtPath" Text="/sdcard" KeyDown="TxtPath_KeyDown"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                 FontFamily="Inter, Segoe UI, sans-serif" FontSize="12"
                                 Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                    </Grid>
                </Border>

                <!-- Pill-Shaped Search Bar -->
                <Border Grid.Column="4" Background="{DynamicResource FluxSurfaceContainer}"
                        CornerRadius="{DynamicResource FluxRadiusXl}" Padding="12,4" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{DynamicResource FluxOutline}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                 FontFamily="Inter, Segoe UI, sans-serif" FontSize="13"
                                 Foreground="{DynamicResource FluxOnSurface}" ToolTip="Search; filters: ext:jpg min:10MB max:1GB after:2026-01-01"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ACTION TOOLBAR -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource FluxOutlineVariant}" BorderThickness="0,1,0,1"
                Padding="14,6" Background="{DynamicResource FluxSurface}">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="CmbQuickAccess" Width="180" Margin="0,0,6,0" Padding="6,3"
                          SelectionChanged="CmbQuickAccess_SelectionChanged" ToolTip="Quick Access and pinned folders"/>
                <Button x:Name="BtnToggleFavorite" Content="★" Click="BtnToggleFavorite_Click" Style="{DynamicResource FluxActionButton}" ToolTip="Pin or unpin current folder"/>
                <Rectangle Width="1" Height="16" Fill="{DynamicResource FluxOutlineVariant}" Margin="8,0"/>
                <Button Style="{DynamicResource FluxActionButton}" Click="BtnNewFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" Margin="0,0,6,0" Foreground="{DynamicResource FluxPrimaryContainer}"/>
                        <TextBlock Text="New Folder" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="16" Fill="{DynamicResource FluxOutlineVariant}" Margin="8,0"/>

                <Button Style="{DynamicResource FluxActionButton}" Click="BtnRename_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️" Margin="0,0,6,0"/>
                        <TextBlock Text="Rename" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                    </StackPanel>
                </Button>

                <Button Style="{DynamicResource FluxActionButton}" Click="BtnDelete_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" Margin="0,0,6,0" Foreground="{DynamicResource FluxError}"/>
                        <TextBlock Text="Delete" Foreground="{DynamicResource FluxError}"/>
                    </StackPanel>
                </Button>

                <Button Style="{DynamicResource FluxActionButton}" Click="BtnRefreshDevice_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0" Foreground="{DynamicResource FluxPrimaryContainer}"/>
                        <TextBlock Text="Refresh" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="16" Fill="{DynamicResource FluxOutlineVariant}" Margin="8,0"/>

                <Button Style="{DynamicResource FluxActionButton}" Click="BtnDiskAnalyzer_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Margin="0,0,6,0" Foreground="{DynamicResource FluxPrimaryContainer}"/>
                        <TextBlock Text="Storage Analyzer" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                    </StackPanel>
                </Button>

                <Button Style="{DynamicResource FluxActionButton}" Click="BtnDeleteEmptyFolders_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧹" Margin="0,0,6,0" Foreground="{DynamicResource FluxPrimaryContainer}"/>
                        <TextBlock Text="Clean Empty Folders" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- MAIN VIEW CONTAINER (FILE EXPLORER OR IN-APP SETTINGS) -->
        <Grid Grid.Row="2" Background="{DynamicResource FluxSurfaceContainerLowest}">
            <!-- 1. FILE EXPLORER VIEW -->
            <Grid x:Name="PnlFileExplorer" Visibility="Visible">
                <!-- Background Watermark Android Mascot Logo -->
                <TextBlock Text="🤖" FontSize="320" Foreground="#04000000" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,40,0" IsHitTestVisible="False"/>

                <ListView x:Name="LstFiles" Background="Transparent" Foreground="{DynamicResource FluxOnSurface}"
                          SelectionMode="Extended" SelectionChanged="LstFiles_SelectionChanged"
                          AllowDrop="True" Drop="LstFiles_Drop" DragOver="LstFiles_DragOver"
                          MouseDoubleClick="LstFiles_MouseDoubleClick" BorderThickness="0"
                          FontSize="13" FontFamily="Inter, Segoe UI, sans-serif">
                    <ListView.ContextMenu>
                        <ContextMenu Style="{DynamicResource FluxContextMenu}">
                            <MenuItem Header="📥 Download to PC..." Click="BtnCopyToPC_Click"/>
                            <MenuItem Header="📤 Upload Files Here..." Click="BtnUploadFiles_Click"/>
                            <MenuItem Header="👁 Preview / Open File" Click="BtnPreviewFile_Click"/>
                            <MenuItem Header="★ Pin Current Folder" Click="BtnToggleFavorite_Click"/>
                            <MenuItem Header="Sort">
                                <MenuItem Header="Name" Tag="Name" Click="Sort_Click"/>
                                <MenuItem Header="Size" Tag="Size" Click="Sort_Click"/>
                                <MenuItem Header="Modified Date" Tag="Date" Click="Sort_Click"/>
                                <Separator/><MenuItem Header="Toggle Ascending / Descending" Tag="Toggle" Click="Sort_Click"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="📊 Analyze Storage Space..." Click="ContextAnalyzeStorage_Click"/>
                            <MenuItem Header="Split Folder..." Click="ContextSplitFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="📁 New Folder..." Click="BtnNewFolder_Click"/>
                            <MenuItem Header="✏️ Rename..." Click="BtnRename_Click"/>
                            <MenuItem Header="🗑️ Delete" Click="BtnDelete_Click"/>
                            <Separator/>
                            <MenuItem Header="🧹 Clean Empty Folders..." Click="BtnDeleteEmptyFolders_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <StaticResource ResourceKey="FluxListViewItem"/>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <!-- NAME Column -->
                            <GridViewColumn Width="420">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="NAME" Style="{DynamicResource FluxColumnHeader}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Dynamic Vector Icon: Vibrant Yellow Folder for Directories, File Icon for Files -->
                                            <ContentControl Content="{Binding}" Margin="2,0,10,0">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Icon}" FontSize="16" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDir}" Value="True">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <!-- Vibrant Windows 11 Fluent Yellow Folder Vector Graphic -->
                                                                        <DataTemplate>
                                                                            <Grid Width="22" Height="18" VerticalAlignment="Center">
                                                                                <!-- Back Folder Tab -->
                                                                                <Path Data="M 1.5 2 C 1.5 1.5 2 1 2.8 1 L 7.2 1 C 8 1 8.5 1.5 9 2.2 L 10 3.8 L 19 3.8 C 20 3.8 20.5 4.3 20.5 5.3 L 20.5 15.5 C 20.5 16.5 20 17 19 17 L 2.8 17 C 1.8 17 1.5 16.5 1.5 15.5 Z" Fill="{Binding FolderBrush}" Opacity="0.72"/>
                                                                                <!-- Front Folder Body -->
                                                                                <Path Data="M 0.5 5 C 0.5 4.3 1.2 3.8 2.2 3.8 L 19.8 3.8 C 20.8 3.8 21.5 4.3 21.5 5 L 20.2 15 C 20 16 19.1 16.8 18 16.8 L 4 16.8 C 2.9 16.8 2 16 1.8 15 Z" Fill="{Binding FolderBrush}"/>
                                                                                <!-- Highlight Edge -->
                                                                                <Path Data="M 1 4.5 L 21 4.5 L 20.6 6.5 L 1.4 6.5 Z" Fill="#FFFFFF" Opacity="0.25"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                       Style="{DynamicResource FluxBodyMd}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- LAST MODIFIED Column -->
                            <GridViewColumn Width="240">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="LAST MODIFIED" Style="{DynamicResource FluxColumnHeader}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedDateStr}" Style="{DynamicResource FluxBodySm}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- SIZE Column -->
                            <GridViewColumn Width="140">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="SIZE" Style="{DynamicResource FluxColumnHeader}"
                                                          HorizontalContentAlignment="Right"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedSize}" Style="{DynamicResource FluxBodySm}"
                                                   HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- NO DEVICE CONNECTED EMPTY STATE -->
                <Border x:Name="PnlNoDevice" Visibility="Collapsed"
                        Background="{DynamicResource FluxSurfaceContainerLowest}"
                        BorderBrush="{DynamicResource FluxOutlineVariant}" BorderThickness="1"
                        CornerRadius="{DynamicResource FluxRadiusLg}"
                        Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="28" Effect="{DynamicResource FluxShadowLevel2}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="72" Height="72" Background="{DynamicResource FluxSurfaceContainer}"
                                CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔌" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="22" Height="22" Background="{DynamicResource FluxError}" CornerRadius="11"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                                    <TextBlock Text="⚡" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="No Device Connected" Style="{DynamicResource FluxHeadlineMd}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Connect your device via USB and make sure it's unlocked with File Transfer mode enabled."
                                   Style="{DynamicResource FluxBodySm}" Foreground="{DynamicResource FluxOnSurfaceVariant}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Button Content="🔄 Try Again" Click="BtnRefreshDevice_Click"
                                Style="{DynamicResource FluxPrimaryButton}" Height="38" Margin="0,0,0,10"/>

                        <Button Content="View Troubleshooting Guide" Click="BtnTroubleshoot_Click"
                                Style="{DynamicResource FluxGhostButton}" Height="36" Margin="0,0,0,20"/>

                        <Border Background="{DynamicResource FluxSurfaceContainerLow}" CornerRadius="{DynamicResource FluxRadius}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="Tip: If your device isn't showing up, try a different USB port or original manufacturer cable."
                                           Style="{DynamicResource FluxBodySm}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. IN-APP SETTINGS VIEW OVERLAY -->
            <Grid x:Name="PnlSettingsView" Visibility="Collapsed" Background="{DynamicResource FluxSurface}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- SETTINGS TOP BAR -->
                    <Border Grid.Row="0" Margin="0,0,0,12" Padding="4,0,4,8" BorderBrush="{DynamicResource FluxOutlineVariant}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="← Back to Files" Click="BtnHideSettings_Click"
                                        Style="{DynamicResource FluxGhostButton}" Padding="10,6" Margin="0,0,16,0"/>
                                <TextBlock Text="⚙️  Application Settings" Style="{DynamicResource FluxHeadlineMd}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SETTINGS MAIN BODY (SIDEBAR + CONTENT) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SIDEBAR CATEGORY MENU -->
                        <Border Grid.Column="0" Background="{DynamicResource FluxSurfaceContainerLow}"
                                CornerRadius="8" Margin="0,0,12,0" Padding="6">
                            <StackPanel x:Name="PnlCategoryMenu">
                                <Button x:Name="TabGeneral" Content="⚙️  General" Click="TabButton_Click" Tag="0"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabAppearance" Content="🎨  Appearance" Click="TabButton_Click" Tag="1"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabTransfers" Content="🚀  Transfers" Click="TabButton_Click" Tag="2"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabDevice" Content="📱  Device" Click="TabButton_Click" Tag="3"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabExplorer" Content="📁  Explorer" Click="TabButton_Click" Tag="4"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabAdvanced" Content="🛠️  Advanced" Click="TabButton_Click" Tag="5"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabAbout" Content="ℹ️  About" Click="TabButton_Click" Tag="6"
                                        Style="{StaticResource SettingsTabButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT CONTENT PANELS -->
                        <Border Grid.Column="1" Background="{DynamicResource FluxSurfaceContainerLowest}"
                                CornerRadius="8" BorderBrush="{DynamicResource FluxOutlineVariant}" BorderThickness="1" Padding="20">
                            <Grid>
                                <!-- 0. GENERAL PANEL -->
                                <ScrollViewer x:Name="PnlGeneral" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Startup &amp; Background Behavior" Style="{DynamicResource FluxTitleMd}" Margin="0,0,0,12"/>
                                        <CheckBox x:Name="ChkLaunchStartup" Content="Launch at Windows startup" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkMinimizeTray" Content="Minimize to system tray on close" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkAutoDetect" Content="Auto detect Android USB devices" IsChecked="True" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkAutoReconnect" Content="Auto reconnect device when plugged in" IsChecked="True" Margin="0,0,0,10"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 1. APPEARANCE PANEL -->
                                <ScrollViewer x:Name="PnlAppearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Theme Preferences" Style="{DynamicResource FluxTitleMd}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Premium Color Theme:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource FluxOnSurfaceVariant}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbThemePalette" SelectedIndex="0" Margin="0,0,0,12" Padding="8,4" SelectionChanged="AppearanceTheme_SelectionChanged">
                                            <ComboBoxItem Content="Emerald Glass"/>
                                            <ComboBoxItem Content="VS Code"/>
                                            <ComboBoxItem Content="Nord Aurora"/>
                                            <ComboBoxItem Content="Dracula"/>
                                            <ComboBoxItem Content="Tokyo Night"/>
                                            <ComboBoxItem Content="Catppuccin"/>
                                            <ComboBoxItem Content="Rosé Pine"/>
                                            <ComboBoxItem Content="Solarized"/>
                                            <ComboBoxItem Content="One Dark"/>
                                            <ComboBoxItem Content="GitHub"/>
                                            <ComboBoxItem Content="Monokai"/>
                                            <ComboBoxItem Content="Cyberpunk"/>
                                        </ComboBox>

                                        <TextBlock Text="Theme Appearance:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource FluxOnSurfaceVariant}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbThemeMode" SelectedIndex="0" Margin="0,0,0,16" Padding="8,4" SelectionChanged="AppearanceTheme_SelectionChanged">
                                            <ComboBoxItem Content="Follow Windows"/>
                                            <ComboBoxItem Content="Light"/>
                                            <ComboBoxItem Content="Dark"/>
                                        </ComboBox>

                                        <Border Background="{DynamicResource FluxSurfaceContainerLow}" BorderBrush="{DynamicResource FluxOutlineVariant}"
                                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="Live theme preview" FontWeight="SemiBold" Foreground="{DynamicResource FluxOnSurface}"/>
                                                <TextBlock Text="Surfaces, cards, navigation, selections and progress accents update instantly."
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Folder Accent Color:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource FluxOnSurfaceVariant}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbFolderColor" SelectedIndex="0" Margin="0,0,0,16" Padding="8,4">
                                            <ComboBoxItem Content="Classic Yellow"/>
                                            <ComboBoxItem Content="Ocean Blue"/>
                                            <ComboBoxItem Content="Emerald Green"/>
                                            <ComboBoxItem Content="Royal Purple"/>
                                            <ComboBoxItem Content="Crimson Red"/>
                                            <ComboBoxItem Content="Vivid Orange"/>
                                        </ComboBox>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 2. TRANSFERS PANEL -->
                                <ScrollViewer x:Name="PnlTransfers" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="File Transfer &amp; Conflict Policies" Style="{DynamicResource FluxTitleMd}" Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="Conflict Resolution (When File Exists):" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbConflict" SelectedIndex="1" Margin="0,0,0,14" Padding="8,4">
                                            <ComboBoxItem Content="Ask Every Time"/>
                                            <ComboBoxItem Content="Skip Existing (Default)"/>
                                            <ComboBoxItem Content="Replace Existing"/>
                                            <ComboBoxItem Content="Rename Automatically"/>
                                        </ComboBox>

                                        <TextBlock Text="File Compare Method:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbCompareMethod" SelectedIndex="1" Margin="0,0,0,14" Padding="8,4">
                                            <ComboBoxItem Content="Filename Only"/>
                                            <ComboBoxItem Content="Filename + Size (Default)"/>
                                            <ComboBoxItem Content="Filename + Size + Modified Date"/>
                                        </ComboBox>

                                        <CheckBox x:Name="ChkVerifyCopied" Content="Verify copied files after transfer" IsChecked="True" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="ChkRetryFailed" Content="Retry failed transfers automatically" IsChecked="True" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Retry Count:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox x:Name="CmbRetryCount" SelectedIndex="1" Width="80" Padding="6,2">
                                                <ComboBoxItem Content="1"/>
                                                <ComboBoxItem Content="3"/>
                                                <ComboBoxItem Content="5"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 3. DEVICE PANEL -->
                                <ScrollViewer x:Name="PnlDevice" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Device &amp; Storage Preferences" Style="{DynamicResource FluxTitleMd}" Margin="0,0,0,12"/>

                                        <TextBlock Text="Default Storage Location:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbDefaultStorage" SelectedIndex="0" Margin="0,0,0,16" Padding="8,4">
                                            <ComboBoxItem Content="Internal Storage (/sdcard)"/>
                                            <ComboBoxItem Content="SD Card"/>
                                        </ComboBox>

                                        <TextBlock Text="Auto Refresh Device Polling Interval:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbRefreshInterval" SelectedIndex="1" Margin="0,0,0,16" Padding="8,4">
                                            <ComboBoxItem Content="1 sec"/>
                                            <ComboBoxItem Content="3 sec (Default)"/>
                                            <ComboBoxItem Content="5 sec"/>
                                        </ComboBox>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 4. EXPLORER PANEL -->
                                <ScrollViewer x:Name="PnlExplorer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="File Explorer Preferences" Style="{DynamicResource FluxTitleMd}" Margin="0,0,0,12"/>

                                        <TextBlock Text="Default Startup View:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbDefaultView" SelectedIndex="0" Margin="0,0,0,14" Padding="8,4">
                                            <ComboBoxItem Content="Details (List View)"/>
                                            <ComboBoxItem Content="Large Icons (Grid View)"/>
                                        </ComboBox>

                                        <CheckBox x:Name="ChkShowHidden" Content="Show hidden files and folders" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="ChkShowExtensions" Content="Show file extensions" IsChecked="True" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="ChkShowFolderSizes" Content="Show folder sizes (slower)" Margin="0,0,0,14"/>

                                        <TextBlock Text="Copy Behavior:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkPreserveDate" Content="Preserve modified date" IsChecked="True" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkPreserveStructure" Content="Preserve folder structure" IsChecked="True" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkCreateMissing" Content="Create missing folders automatically" IsChecked="True" Margin="0,0,0,6"/>

                                        <!-- AUTO-SPLIT ON TRANSFER CARD -->
                                        <Border Background="{DynamicResource FluxSurfaceContainerLow}" Padding="12" CornerRadius="6" Margin="0,10,0,6">
                                            <StackPanel>
                                                <CheckBox x:Name="ChkAutoSplit" Content="⚡ Automatically split files into batch subfolders on transfer" IsChecked="False" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                                <Grid Margin="20,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="Batch Size (Files/Folder):" FontSize="11.5" Margin="0,0,0,4" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                                                        <ComboBox x:Name="CmbAutoSplitSize" SelectedIndex="2" Padding="6,3">
                                                            <ComboBoxItem Content="100 files"/>
                                                            <ComboBoxItem Content="250 files"/>
                                                            <ComboBoxItem Content="500 files"/>
                                                            <ComboBoxItem Content="1000 files"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Folder Naming Style:" FontSize="11.5" Margin="0,0,0,4" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                                                        <ComboBox x:Name="CmbAutoSplitNaming" SelectedIndex="0" Padding="6,3">
                                                            <ComboBoxItem Content="photo-1, photo-2..."/>
                                                            <ComboBoxItem Content="day 1-1, day 1-2..."/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 5. ADVANCED PANEL -->
                                <ScrollViewer x:Name="PnlAdvanced" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Advanced ADB Configuration" Style="{DynamicResource FluxTitleMd}" Margin="0,0,0,12"/>

                                        <TextBlock Text="ADB Executable Path:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtCustomAdbPath" Padding="8,6" FontSize="12"/>
                                            <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseAdb_Click" Margin="8,0,0,0" Padding="12,4" Style="{DynamicResource FluxGhostButton}"/>
                                        </Grid>

                                        <TextBlock Text="ADB Operation Timeout:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbAdbTimeout" SelectedIndex="0" Margin="0,0,0,14" Padding="8,4">
                                            <ComboBoxItem Content="30 sec (Default)"/>
                                            <ComboBoxItem Content="60 sec"/>
                                            <ComboBoxItem Content="120 sec"/>
                                        </ComboBox>

                                        <CheckBox x:Name="ChkDebugLogging" Content="Enable Debug Logging" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkWirelessDevices" Content="Show Wireless ADB devices (Wi-Fi debugging)" Margin="0,0,0,6"/>
                                        <TextBlock Text="Log Retention:" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,6"/>
                                        <ComboBox x:Name="CmbLogRetention" SelectedIndex="1" Margin="0,0,0,14" Padding="8,4">
                                            <ComboBoxItem Content="7 days"/><ComboBoxItem Content="14 days"/><ComboBoxItem Content="30 days"/><ComboBoxItem Content="90 days"/>
                                        </ComboBox>
                                        <WrapPanel>
                                            <Button Content="Export Settings" Click="BtnExportSettings_Click" Style="{DynamicResource FluxGhostButton}" Padding="10,5" Margin="0,0,8,8"/>
                                            <Button Content="Import Settings" Click="BtnImportSettings_Click" Style="{DynamicResource FluxGhostButton}" Padding="10,5" Margin="0,0,8,8"/>
                                            <Button Content="Reset Settings" Click="BtnResetSettings_Click" Style="{DynamicResource FluxGhostButton}" Padding="10,5" Margin="0,0,8,8"/>
                                            <Button Content="Clear Log Files" Click="BtnClearLogFiles_Click" Style="{DynamicResource FluxGhostButton}" Padding="10,5" Margin="0,0,8,8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 6. ABOUT PANEL -->
                                <ScrollViewer x:Name="PnlAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Image Source="Assets/logo.png" Width="48" Height="48" Margin="0,0,12,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Open Transfer" Style="{DynamicResource FluxTitleMd}" FontWeight="Bold"/>
                                                <TextBlock Text="Native High-Speed Android USB File Transfer" Style="{DynamicResource FluxBodySm}" Foreground="{DynamicResource FluxOutline}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Background="{DynamicResource FluxSurfaceContainerLow}" Padding="12" CornerRadius="6" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtAboutVersion" Text="Version: --" FontSize="12" Margin="0,0,0,4"/>
                                                <TextBlock Text="Build: 2026.11.07" FontSize="12" Margin="0,0,0,4"/>
                                                <TextBlock Text="ADB Binary: Platform Tools 34.0.5" FontSize="12"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- DEVELOPER INFORMATION CARD -->
                                        <Border Background="{DynamicResource FluxSurfaceContainerLow}" Padding="14" CornerRadius="8" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="👨‍💻 Developer Information" Style="{DynamicResource FluxBodySm}" FontWeight="Bold" Foreground="{DynamicResource FluxOnSurface}" Margin="0,0,0,8"/>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="👤 Developer:" Width="110" Style="{DynamicResource FluxBodySm}" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                                                    <TextBlock Text="Jaseem Mhd" Style="{DynamicResource FluxBodySm}" FontWeight="SemiBold" Foreground="{DynamicResource FluxOnSurface}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="📸 Instagram:" Width="110" Style="{DynamicResource FluxBodySm}" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                                                    <TextBlock Text="magical_world_i_see" Style="{DynamicResource FluxBodySm}" FontWeight="SemiBold" Foreground="{DynamicResource FluxPrimaryContainer}" Cursor="Hand" MouseLeftButtonDown="BtnInstagram_Click"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🐙 GitHub:" Width="110" Style="{DynamicResource FluxBodySm}" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                                                    <TextBlock Text="github.com/amorsoftlab/OpenTransfer" Style="{DynamicResource FluxBodySm}" FontWeight="SemiBold" Foreground="{DynamicResource FluxPrimaryContainer}" Cursor="Hand" MouseLeftButtonDown="BtnGitHubProfile_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="🔄 Check for Updates Now" Click="BtnCheckUpdates_Click" Padding="12,6" Style="{DynamicResource FluxPrimaryButton}" Margin="0,0,10,0"/>
                                            <Button Content="📁 Open Logs Folder" Click="BtnOpenLogsFolder_Click" Padding="12,6" Style="{DynamicResource FluxGhostButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- BOTTOM BUTTON BAR -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel" Click="BtnHideSettings_Click" Width="90" Height="32" Margin="0,0,10,0" Style="{DynamicResource FluxGhostButton}"/>
                        <Button Content="Save Settings" Click="BtnSaveSettings_Click" Width="120" Height="32" Style="{DynamicResource FluxPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- COLLAPSIBLE ACTIVITY LOG DRAWER -->
        <Border Grid.Row="3" x:Name="PnlActivityLogs" Visibility="Collapsed"
                Background="{DynamicResource FluxSurfaceContainerLowest}"
                BorderBrush="{DynamicResource FluxOutlineVariant}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="ACTIVITY LOGS" Style="{DynamicResource FluxLabelMd}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📋 Copy" Click="BtnCopyLogs_Click" Foreground="{DynamicResource FluxOnSurfaceVariant}"
                                Background="Transparent" BorderThickness="0"
                                FontFamily="Inter, Segoe UI, sans-serif" FontSize="12" Cursor="Hand" Margin="0,0,12,0"/>
                        <Button Content="🗑️ Clear" Click="BtnClearLogs_Click" Foreground="{DynamicResource FluxOnSurfaceVariant}"
                                Background="Transparent" BorderThickness="0"
                                FontFamily="Inter, Segoe UI, sans-serif" FontSize="12" Cursor="Hand" Margin="0,0,12,0"/>
                        <Button Content="✕" Click="BtnToggleLogs_Click" Foreground="{DynamicResource FluxOutline}"
                                Background="Transparent" BorderThickness="0"
                                FontFamily="Inter, Segoe UI, sans-serif" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <TextBox Grid.Row="1" x:Name="TxtLogConsole"
                         Background="{DynamicResource FluxSurfaceContainerLow}"
                         Foreground="{DynamicResource FluxOnSurfaceVariant}"
                         FontFamily="Consolas" FontSize="11"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         BorderThickness="1" BorderBrush="{DynamicResource FluxOutlineVariant}" Padding="8"/>
            </Grid>
        </Border>

        <!-- BOTTOM STATUS FOOTER BAR (Matching Exact Target UI Screenshot) -->
        <Border Grid.Row="4" Background="{DynamicResource FluxSurface}" BorderBrush="{DynamicResource FluxOutlineVariant}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Status Indicators: 🟢 Connected | 15 Items | 1 Selected | Free 82.4 GB -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Connected Badge -->
                    <StackPanel Orientation="Horizontal" x:Name="PnlStatusConnected">
                        <TextBlock x:Name="TxtConnectionDot" Text="⚪" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="TxtConnectionStatus" Text="No Device" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FluxOutline}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="14" Fill="{DynamicResource FluxOutlineVariant}" Margin="14,0"/>

                    <!-- Items Count -->
                    <TextBlock x:Name="TxtStatusFooter" Text="15 Items" FontSize="12" Foreground="{DynamicResource FluxOnSurfaceVariant}" VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="14" Fill="{DynamicResource FluxOutlineVariant}" Margin="14,0"/>

                    <!-- Selected Stats (Highlighted in Vibrant Primary Blue #005FB8) -->
                    <TextBlock x:Name="TxtSelectedStats" Text="1 Selected" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FluxPrimaryContainer}" VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="14" Fill="{DynamicResource FluxOutlineVariant}" Margin="14,0"/>

                    <!-- Free Storage Info (Clickable to open Disk Analyzer) -->
                    <Border Cursor="Hand" MouseDown="TxtFreeStorage_MouseDown"
                            ToolTip="Click to open Storage Space Analyzer" Padding="4,2"
                            Background="Transparent" CornerRadius="4">
                        <TextBlock x:Name="TxtFreeStorage" Text="Free --" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{DynamicResource FluxPrimaryContainer}"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Right Controls: Settings + Logs Button + Grid/List View Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource FluxActionButton}" Click="BtnSettings_Click" Padding="8,4" Margin="0,0,10,0" ToolTip="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,6,0" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                            <TextBlock Text="Settings" Foreground="{DynamicResource FluxOnSurface}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource FluxActionButton}" Click="BtnToggleLogs_Click" Padding="8,4" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Margin="0,0,6,0" Foreground="{DynamicResource FluxOnSurfaceVariant}"/>
                            <TextBlock Text="Logs" Foreground="{DynamicResource FluxOnSurface}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource FluxActionButton}" Click="BtnHistory_Click" Padding="8,4" Margin="0,0,10,0" ToolTip="Transfer History">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🕘" Margin="0,0,5,0"/><TextBlock Text="History"/></StackPanel>
                    </Button>

                    <!-- View Toggle Group -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Grid View Icon -->
                        <Button x:Name="BtnGridView" Click="BtnGridView_Click" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,4,0" ToolTip="Grid View">
                            <Border x:Name="BdrGridView" Background="Transparent" CornerRadius="4" Padding="6,4">
                                <TextBlock x:Name="TxtGridViewIcon" Text="㗊" FontSize="14" Foreground="{DynamicResource FluxOutline}" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- List View Icon (Active Blue Pill State by Default) -->
                        <Button x:Name="BtnListView" Click="BtnListView_Click" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="List View">
                            <Border x:Name="BdrListView" Background="{DynamicResource FluxPrimaryContainer}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="TxtListViewIcon" Text=":=" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
