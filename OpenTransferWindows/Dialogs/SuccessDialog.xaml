<Window x:Class="openTransferWPF.Dialogs.SuccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Success" Icon="../Assets/logo.ico" Height="200" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource FluxSurface}" Foreground="{StaticResource FluxOnSurface}"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="✅" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTitle" Text="Success" Style="{StaticResource FluxTitleMd}" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="TxtMessage" Grid.Row="1" Text="Operation completed successfully." 
                       Style="{StaticResource FluxBodySm}" Foreground="{StaticResource FluxOnSurfaceVariant}" 
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Click="BtnOk_Click" IsDefault="True" Width="100" Height="32" Style="{StaticResource FluxPrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
