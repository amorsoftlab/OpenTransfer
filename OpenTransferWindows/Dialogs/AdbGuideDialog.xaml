<Window x:Class="openTransferWPF.Dialogs.AdbGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADB Connection Guide" Height="560" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource FluxSurfaceContainerLowest}" Foreground="{StaticResource FluxOnSurface}"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Vector Illustration -->
            <RowDefinition Height="*"/>    <!-- 3 Step Cards -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="📱 ADB &amp; Device Connection Guide" Style="{StaticResource FluxTitleMd}"
                       FontWeight="Bold" FontSize="18"/>
            <TextBlock Text="Follow these steps to connect your phone for ultra-fast file transfer:"
                       Style="{StaticResource FluxBodySm}" Foreground="{StaticResource FluxOnSurfaceVariant}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Vector Illustration Banner -->
        <Border Grid.Row="1" Background="{StaticResource FluxSurfaceContainerLow}"
                CornerRadius="{StaticResource FluxRadiusLg}" Padding="12" Margin="0,0,0,16">
            <Image Source="/Assets/adb_connect_guide.png" Height="150" Stretch="Uniform"/>
        </Border>

        <!-- 3 Step Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Step 1 -->
                <Border Background="{StaticResource FluxSurface}" BorderBrush="{StaticResource FluxOutlineVariant}"
                        BorderThickness="1" CornerRadius="{StaticResource FluxRadius}" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" Background="{StaticResource FluxPrimaryContainer}"
                                CornerRadius="16" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="🔌 Plug USB Data Cable" Style="{StaticResource FluxBodyMd}" FontWeight="SemiBold"/>
                            <TextBlock Text="Connect your Android phone to a USB port on your PC using an original data cable."
                                       Style="{StaticResource FluxBodySm}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 2 -->
                <Border Background="{StaticResource FluxSurface}" BorderBrush="{StaticResource FluxOutlineVariant}"
                        BorderThickness="1" CornerRadius="{StaticResource FluxRadius}" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" Background="{StaticResource FluxPrimaryContainer}"
                                CornerRadius="16" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="2" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="📲 Enable File Transfer (MTP) Mode" Style="{StaticResource FluxBodyMd}" FontWeight="SemiBold"/>
                            <TextBlock Text="Unlock phone screen, swipe down notification bar, and select 'File Transfer / MTP'."
                                       Style="{StaticResource FluxBodySm}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 3 -->
                <Border Background="{StaticResource FluxSurface}" BorderBrush="{StaticResource FluxOutlineVariant}"
                        BorderThickness="1" CornerRadius="{StaticResource FluxRadius}" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" Background="{StaticResource FluxPrimaryContainer}"
                                CornerRadius="16" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="3" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="⚙️ Turn On USB Debugging" Style="{StaticResource FluxBodyMd}" FontWeight="SemiBold"/>
                            <TextBlock Text="In Settings → Developer Options, enable 'USB Debugging' and tap 'Allow / Trust' on phone."
                                       Style="{StaticResource FluxBodySm}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="🔄 Check Connection" Click="BtnCheckConnection_Click" Width="160" Height="36"
                    Margin="0,0,10,0" Style="{StaticResource FluxPrimaryButton}" Padding="0"/>
            <Button Content="Close" Click="BtnClose_Click" Width="90" Height="36"
                    Style="{StaticResource FluxGhostButton}" Padding="0"/>
        </StackPanel>
    </Grid>
</Window>
