<Window x:Class="openTransferWPF.Dialogs.SplitFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Split Folder Options" Icon="../Assets/logo.ico" Height="360" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource FluxSurface}" Foreground="{StaticResource FluxOnSurface}"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Split Folder Files" Style="{StaticResource FluxTitleMd}"/>
            <TextBlock Text="Organize large folders or inner subfolders into batch directories."
                       Style="{StaticResource FluxBodySm}" Margin="0,4,0,16" Foreground="{StaticResource FluxOnSurfaceVariant}"/>
        </StackPanel>

        <!-- Inputs Section -->
        <StackPanel Grid.Row="1">
            <!-- Files per folder -->
            <TextBlock Text="Files Per Batch Folder:" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource FluxOnSurface}" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtFilesPerFolder" Text="500" Padding="8,6" FontSize="13"
                     Background="{StaticResource FluxSurfaceContainerLowest}"
                     Foreground="{StaticResource FluxOnSurface}"
                     BorderBrush="{StaticResource FluxOutlineVariant}" BorderThickness="1"
                     Margin="0,0,0,14"/>

            <!-- Naming Separator -->
            <TextBlock Text="Subfolder Naming Format:" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource FluxOnSurface}" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbSeparator" SelectedIndex="0" Padding="8,6" FontSize="13"
                      Background="{StaticResource FluxSurfaceContainerLowest}"
                      Foreground="{StaticResource FluxOnSurface}"
                      BorderBrush="{StaticResource FluxOutlineVariant}"
                      Margin="0,0,0,14">
                <ComboBoxItem Content="Hyphen '-'  (e.g., day 1-1, day 1-2)"/>
                <ComboBoxItem Content="Underscore '_'  (e.g., day 1_1, day 1_2)"/>
            </ComboBox>

            <!-- Inner subfolders checkbox -->
            <CheckBox x:Name="ChkProcessInnerFolders" IsChecked="True"
                      Content="Process inner subfolders if present (e.g. day 1 → day 1-1)"
                      FontFamily="Inter, Segoe UI, sans-serif" FontSize="12.5" FontWeight="SemiBold"
                      Foreground="{StaticResource FluxOnSurface}"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Width="90" Height="32" Margin="0,0,10,0"
                    Style="{StaticResource FluxGhostButton}" Padding="0"/>
            <Button Content="Split Folder" Click="BtnSplit_Click" Width="130" Height="32"
                    Style="{StaticResource FluxPrimaryButton}" Padding="0"/>
        </StackPanel>
    </Grid>
</Window>
