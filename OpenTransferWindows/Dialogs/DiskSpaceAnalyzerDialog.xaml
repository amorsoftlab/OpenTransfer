<Window x:Class="openTransferWPF.Dialogs.DiskSpaceAnalyzerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android Disk Space Analyzer" Height="650" Width="780"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource FluxSurface}" Foreground="{StaticResource FluxOnSurface}"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Storage Overview Card -->
            <RowDefinition Height="Auto"/> <!-- Toolbar & Breadcrumb -->
            <RowDefinition Height="*"/>    <!-- Ranked Space Hoggers List -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. STORAGE CAPACITY OVERVIEW CARD -->
        <Border Grid.Row="0" Background="{StaticResource FluxSurfaceContainerLowest}"
                BorderBrush="{StaticResource FluxOutlineVariant}" BorderThickness="1"
                CornerRadius="{StaticResource FluxRadiusLg}" Padding="20,16" Margin="0,0,0,16"
                Effect="{StaticResource FluxShadowLevel2}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title & Icon -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Storage Capacity Analyzer" Style="{StaticResource FluxHeadlineMd}" FontSize="18"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCapacityPercent" Text="--%" Style="{StaticResource FluxTitleMd}"
                               FontWeight="Bold" Foreground="{StaticResource FluxPrimaryContainer}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Storage Progress Bar -->
                <ProgressBar Grid.Row="1" x:Name="PrgStorageMeter" Style="{StaticResource FluxProgressBar}" Height="8" Margin="0,0,0,8"/>

                <!-- Storage Stats Text -->
                <Grid Grid.Row="2">
                    <TextBlock x:Name="TxtStorageDetails" Text="Loading storage details..."
                               Style="{StaticResource FluxBodySm}" Foreground="{StaticResource FluxOnSurfaceVariant}"/>
                    <TextBlock x:Name="TxtFreeSpaceText" Text="Free Space: --"
                               Style="{StaticResource FluxBodySm}" FontWeight="SemiBold"
                               Foreground="{StaticResource FluxPrimaryContainer}" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. TOOLBAR & BREADCRUMB NAVIGATION -->
        <Border Grid.Row="1" Background="{StaticResource FluxSurfaceContainerLowest}"
                BorderBrush="{StaticResource FluxOutlineVariant}" BorderThickness="1"
                CornerRadius="{StaticResource FluxRadius}" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Parent Folder Button -->
                <Button Grid.Column="0" Content="↑ Parent" Click="BtnUpFolder_Click"
                        Style="{StaticResource FluxActionButton}" Margin="0,0,10,0"/>

                <!-- Breadcrumb Path Pill -->
                <Border Grid.Column="1" Background="{StaticResource FluxSurfaceContainer}"
                        CornerRadius="{StaticResource FluxRadius}" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📱" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurrentPath" Text="/sdcard" Style="{StaticResource FluxBodySm}"
                                   FontWeight="SemiBold" Foreground="{StaticResource FluxOnSurface}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Filter Box -->
                <Border Grid.Column="2" Background="{StaticResource FluxSurfaceContainer}"
                        CornerRadius="{StaticResource FluxRadius}" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Grid Width="160">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{StaticResource FluxOutline}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearchFilter" TextChanged="TxtSearchFilter_TextChanged"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                 FontSize="12" Foreground="{StaticResource FluxOnSurface}" ToolTip="Search scanned items"/>
                    </Grid>
                </Border>

                <!-- Refresh Button -->
                <Button Grid.Column="3" Content="🔄 Rescan" Click="BtnRescan_Click"
                        Style="{StaticResource FluxPrimaryButton}" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- 3. RANKED SPACE HOGGERS LISTVIEW -->
        <Grid Grid.Row="2" Background="{StaticResource FluxSurfaceContainerLowest}">
            <ListView x:Name="LstDiskUsage" Background="Transparent" Foreground="{StaticResource FluxOnSurface}"
                      SelectionMode="Single" MouseDoubleClick="LstDiskUsage_MouseDoubleClick"
                      BorderThickness="0" FontSize="13" FontFamily="Inter, Segoe UI, sans-serif">
                <ListView.ContextMenu>
                    <ContextMenu Style="{StaticResource FluxContextMenu}">
                        <MenuItem Header="📁 Drill Down into Folder" Click="ContextDrillDown_Click"/>
                        <MenuItem Header="🗑️ Delete Item" Click="ContextDelete_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.ItemContainerStyle>
                    <StaticResource ResourceKey="FluxListViewItem"/>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <!-- RANK Column -->
                        <GridViewColumn Width="65">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="RANK" Style="{StaticResource FluxColumnHeader}"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RankBadge}" FontWeight="Bold" FontSize="12"
                                               Foreground="{Binding RankColor}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- NAME Column -->
                        <GridViewColumn Width="260">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="ITEM NAME" Style="{StaticResource FluxColumnHeader}"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Dynamic Vector Icon: Yellow Folder for Directories, File Icon for Files -->
                                        <ContentControl Content="{Binding}" Margin="2,0,8,0">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Icon}" FontSize="15" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDir}" Value="True">
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <Grid Width="20" Height="16" VerticalAlignment="Center">
                                                                            <Path Data="M 1.5 2 C 1.5 1.5 2 1 2.8 1 L 7.2 1 C 8 1 8.5 1.5 9 2.2 L 10 3.8 L 19 3.8 C 20 3.8 20.5 4.3 20.5 5.3 L 20.5 15.5 C 20.5 16.5 20 17 19 17 L 2.8 17 C 1.8 17 1.5 16.5 1.5 15.5 Z" Fill="#D97706"/>
                                                                            <Path Data="M 0.5 5 C 0.5 4.3 1.2 3.8 2.2 3.8 L 19.8 3.8 C 20.8 3.8 21.5 4.3 21.5 5 L 20.2 15 C 20 16 19.1 16.8 18 16.8 L 4 16.8 C 2.9 16.8 2 16 1.8 15 Z" Fill="#F59E0B"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       Style="{StaticResource FluxBodyMd}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- USAGE PERCENTAGE Column -->
                        <GridViewColumn Width="220">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="SPACE USAGE %" Style="{StaticResource FluxColumnHeader}"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0" Value="{Binding UsagePercentage, Mode=OneWay}"
                                                     Style="{StaticResource FluxProgressBar}" Height="6" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedPercentage}"
                                                   Style="{StaticResource FluxBodySm}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- CONSUMED SIZE Column -->
                        <GridViewColumn Width="150">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="TOTAL CONSUMED" Style="{StaticResource FluxColumnHeader}"
                                                      HorizontalContentAlignment="Right"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedSize}" Style="{StaticResource FluxBodySm}"
                                               FontWeight="Bold" Foreground="{StaticResource FluxOnSurface}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- SCANNING SPINNER OVERLAY -->
            <Grid x:Name="PnlLoading" Visibility="Visible" Background="#D8FFFFFF">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtLoadingStatus" Text="Analyzing disk space consumption..."
                               Style="{StaticResource FluxTitleMd}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Scanning directory tree via ADB..." Style="{StaticResource FluxBodySm}"
                               Foreground="{StaticResource FluxOnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 4. FOOTER -->
        <Border Grid.Row="3" Padding="0,14,0,0">
            <Grid>
                <TextBlock x:Name="TxtStatusSummary" Text="Ready" Style="{StaticResource FluxBodySm}" VerticalAlignment="Center"/>
                <Button Content="Close" Click="BtnClose_Click" Style="{StaticResource FluxGhostButton}"
                        Width="100" Height="34" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
