<Window x:Class="openTransferWPF.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Icon="../Assets/logo.ico" Height="220" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource FluxSurface}" Foreground="{StaticResource FluxOnSurface}"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE HEADER -->
            <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="Create New Folder" Style="{StaticResource FluxTitleMd}" FontWeight="Bold" Margin="0,0,0,8"/>

            <!-- PROMPT DESCRIPTION -->
            <TextBlock x:Name="TxtPrompt" Grid.Row="1" Text="Enter name for new folder on Android:" Style="{StaticResource FluxBodySm}" Foreground="{StaticResource FluxOnSurfaceVariant}" Margin="0,0,0,14"/>

            <!-- INPUT TEXTBOX -->
            <Border Grid.Row="2" Background="{StaticResource FluxSurfaceContainerLowest}"
                    BorderBrush="{StaticResource FluxOutlineVariant}" BorderThickness="1"
                    CornerRadius="6" Padding="4,2" VerticalAlignment="Top">
                <TextBox x:Name="TxtInput" BorderThickness="0" Background="Transparent"
                         FontFamily="Inter, Segoe UI, sans-serif" FontSize="13"
                         Foreground="{StaticResource FluxOnSurface}" VerticalAlignment="Center" Padding="6,4"/>
            </Border>

            <!-- BUTTON BAR -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Click="BtnCancel_Click" IsCancel="True" Width="85" Height="32" Margin="0,0,10,0" Style="{StaticResource FluxGhostButton}"/>
                <Button x:Name="BtnOk" Content="OK" Click="BtnOk_Click" IsDefault="True" Width="100" Height="32" Style="{StaticResource FluxPrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
