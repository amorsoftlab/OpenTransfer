<Window x:Class="openTransferWPF.Dialogs.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Transfer Options" Height="260" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource FluxSurface}" Foreground="{StaticResource FluxOnSurface}"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="⚡ File Transfer Action" Style="{StaticResource FluxTitleMd}"/>
            <TextBlock Text="How would you like to handle existing files in the destination folder?"
                       Style="{StaticResource FluxBodySm}" Margin="0,4,0,14" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="RadSkip" Content="⏩ Skip Existing Files (Copy Missing Files Only)" IsChecked="True"
                         FontFamily="Inter, Segoe UI, sans-serif" FontSize="13" Margin="0,0,0,10" FontWeight="SemiBold"
                         Foreground="{StaticResource FluxOnSurface}"/>
            <RadioButton x:Name="RadOverwrite" Content="🔄 Overwrite &amp; Replace All Files"
                         FontFamily="Inter, Segoe UI, sans-serif" FontSize="13" Margin="0,0,0,10"
                         Foreground="{StaticResource FluxOnSurface}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Width="90" Height="30" Margin="0,0,10,0"
                    Style="{StaticResource FluxGhostButton}" Padding="0"/>
            <Button Content="Start Transfer" Click="BtnStart_Click" Width="120" Height="30"
                    Style="{StaticResource FluxPrimaryButton}" Padding="0"/>
        </StackPanel>
    </Grid>
</Window>
