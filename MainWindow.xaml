<Window x:Class="openTransferWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Transfer" Icon="Assets/logo.ico" Height="700" Width="920"
        MinHeight="500" MinWidth="720"
        FontFamily="Inter, Segoe UI, sans-serif"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ItemsPanel for Tile Grid View -->
        <ItemsPanelTemplate x:Key="WrapItemsPanel">
            <WrapPanel Width="{Binding (FrameworkElement.ActualWidth), RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"/>
        </ItemsPanelTemplate>

        <!-- ItemsPanel for List View -->
        <ItemsPanelTemplate x:Key="DefaultItemsPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <!-- Tile DataTemplate for Grid View -->
        <DataTemplate x:Key="TileItemTemplate">
            <Border Width="115" Height="110" Margin="5" Padding="6" CornerRadius="8"
                    Background="{StaticResource FluxSurfaceContainerLowest}"
                    BorderBrush="{StaticResource FluxOutlineVariant}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Large Tile Icon -->
                    <ContentControl Grid.Row="0" Content="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Icon}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDir}" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid Width="42" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="M 2.5 3 C 2.5 2.2 3.2 1.5 4.5 1.5 L 12.5 1.5 C 13.8 1.5 14.5 2.2 15.5 3.2 L 17 5 L 33 5 C 34.5 5 35.5 6 35.5 7.5 L 35.5 27 C 35.5 28.5 34.5 29.5 33 29.5 L 4.5 29.5 C 3 29.5 2.5 28.5 2.5 27 Z">
                                                            <Path.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#D97706" Offset="0.0"/>
                                                                    <GradientStop Color="#B45309" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Path.Fill>
                                                        </Path>
                                                        <Path Data="M 1 7 C 1 6 2 5 3.8 5 L 34.2 5 C 36 5 37 6 37 7 L 34.8 26 C 34.4 27.5 32.8 29 31 29 L 7 29 C 5.2 29 3.6 27.5 3.2 26 Z">
                                                            <Path.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#FBBF24" Offset="0.0"/>
                                                                    <GradientStop Color="#F59E0B" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Path.Fill>
                                                        </Path>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- Filename -->
                    <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource FluxBodySm}"
                               FontWeight="SemiBold" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,4,0,2"/>

                    <!-- Size -->
                    <TextBlock Grid.Row="2" Text="{Binding FormattedSize}" FontSize="10"
                               Foreground="{StaticResource FluxOutline}" TextAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Settings Sidebar Tab Button Style with Green Hover -->
        <Style x:Key="SettingsTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource FluxOnSurface}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#10B981"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR: Navigation, Location Path Pill & Search -->
        <Border Grid.Row="0" Padding="14,10" Background="{StaticResource FluxSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Arrows ← → ↑ -->
                <Button Grid.Column="0" Content="←" Style="{StaticResource FluxNavButton}" Click="BtnBack_Click" ToolTip="Back" Margin="0,0,2,0"/>
                <Button Grid.Column="1" Content="→" Style="{StaticResource FluxNavButton}" Click="BtnForward_Click" ToolTip="Forward" Margin="0,0,2,0"/>
                <Button Grid.Column="2" Content="↑" Style="{StaticResource FluxNavButton}" Click="BtnUp_Click" ToolTip="Parent Folder" Margin="0,0,10,0"/>

                <!-- Location Path Pill Bar (Matching Target UI Screenshot) -->
                <Border Grid.Column="3" Background="{StaticResource FluxSurfaceContainer}"
                        CornerRadius="{StaticResource FluxRadiusXl}" Padding="12,4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📱" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" x:Name="CmbDevices" SelectionChanged="CmbDevices_SelectionChanged"
                                  BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                  FontFamily="Inter, Segoe UI, sans-serif" FontSize="13" FontWeight="Bold"
                                  Foreground="{StaticResource FluxOnSurface}" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="2" x:Name="TxtPath" Text="/sdcard" KeyDown="TxtPath_KeyDown"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                 FontFamily="Inter, Segoe UI, sans-serif" FontSize="12"
                                 Foreground="{StaticResource FluxOnSurfaceVariant}"/>
                    </Grid>
                </Border>

                <!-- Pill-Shaped Search Bar -->
                <Border Grid.Column="4" Background="{StaticResource FluxSurfaceContainer}"
                        CornerRadius="{StaticResource FluxRadiusXl}" Padding="12,4" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{StaticResource FluxOutline}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                 FontFamily="Inter, Segoe UI, sans-serif" FontSize="13"
                                 Foreground="{StaticResource FluxOnSurface}" ToolTip="Search sdcard"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ACTION TOOLBAR -->
        <Border Grid.Row="1" BorderBrush="{StaticResource FluxOutlineVariant}" BorderThickness="0,1,0,1"
                Padding="14,6" Background="{StaticResource FluxSurface}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource FluxActionButton}" Click="BtnNewFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" Margin="0,0,6,0" Foreground="{StaticResource FluxPrimaryContainer}"/>
                        <TextBlock Text="New Folder" Foreground="{StaticResource FluxOnSurfaceVariant}"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="16" Fill="{StaticResource FluxOutlineVariant}" Margin="8,0"/>

                <Button Style="{StaticResource FluxActionButton}" Click="BtnRename_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️" Margin="0,0,6,0"/>
                        <TextBlock Text="Rename" Foreground="{StaticResource FluxOnSurfaceVariant}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource FluxActionButton}" Click="BtnDelete_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" Margin="0,0,6,0" Foreground="{StaticResource FluxError}"/>
                        <TextBlock Text="Delete" Foreground="{StaticResource FluxError}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource FluxActionButton}" Click="BtnRefreshDevice_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0" Foreground="{StaticResource FluxPrimaryContainer}"/>
                        <TextBlock Text="Refresh" Foreground="{StaticResource FluxOnSurfaceVariant}"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="16" Fill="{StaticResource FluxOutlineVariant}" Margin="8,0"/>

                <Button Style="{StaticResource FluxActionButton}" Click="BtnDiskAnalyzer_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Margin="0,0,6,0" Foreground="{StaticResource FluxPrimaryContainer}"/>
                        <TextBlock Text="Storage Analyzer" Foreground="{StaticResource FluxOnSurfaceVariant}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- MAIN VIEW CONTAINER (FILE EXPLORER OR IN-APP SETTINGS) -->
        <Grid Grid.Row="2" Background="{StaticResource FluxSurfaceContainerLowest}">
            <!-- 1. FILE EXPLORER VIEW -->
            <Grid x:Name="PnlFileExplorer" Visibility="Visible">
                <!-- Background Watermark Android Mascot Logo -->
                <TextBlock Text="🤖" FontSize="320" Foreground="#04000000" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,40,0" IsHitTestVisible="False"/>

                <ListView x:Name="LstFiles" Background="Transparent" Foreground="{StaticResource FluxOnSurface}"
                          SelectionMode="Extended" SelectionChanged="LstFiles_SelectionChanged"
                          AllowDrop="True" Drop="LstFiles_Drop" DragOver="LstFiles_DragOver"
                          MouseDoubleClick="LstFiles_MouseDoubleClick" BorderThickness="0"
                          FontSize="13" FontFamily="Inter, Segoe UI, sans-serif">
                    <ListView.ContextMenu>
                        <ContextMenu Style="{StaticResource FluxContextMenu}">
                            <MenuItem Header="📥 Download to PC..." Click="BtnCopyToPC_Click"/>
                            <MenuItem Header="📤 Upload Files Here..." Click="BtnUploadFiles_Click"/>
                            <Separator/>
                            <MenuItem Header="📊 Analyze Storage Space..." Click="ContextAnalyzeStorage_Click"/>
                            <MenuItem Header="Split Folder..." Click="ContextSplitFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="📁 New Folder..." Click="BtnNewFolder_Click"/>
                            <MenuItem Header="✏️ Rename..." Click="BtnRename_Click"/>
                            <MenuItem Header="🗑️ Delete" Click="BtnDelete_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <StaticResource ResourceKey="FluxListViewItem"/>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <!-- NAME Column -->
                            <GridViewColumn Width="420">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="NAME" Style="{StaticResource FluxColumnHeader}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Dynamic Vector Icon: Vibrant Yellow Folder for Directories, File Icon for Files -->
                                            <ContentControl Content="{Binding}" Margin="2,0,10,0">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Icon}" FontSize="16" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDir}" Value="True">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <!-- Vibrant Windows 11 Fluent Yellow Folder Vector Graphic -->
                                                                        <DataTemplate>
                                                                            <Grid Width="22" Height="18" VerticalAlignment="Center">
                                                                                <!-- Back Folder Tab -->
                                                                                <Path Data="M 1.5 2 C 1.5 1.5 2 1 2.8 1 L 7.2 1 C 8 1 8.5 1.5 9 2.2 L 10 3.8 L 19 3.8 C 20 3.8 20.5 4.3 20.5 5.3 L 20.5 15.5 C 20.5 16.5 20 17 19 17 L 2.8 17 C 1.8 17 1.5 16.5 1.5 15.5 Z">
                                                                                    <Path.Fill>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                            <GradientStop Color="#D97706" Offset="0.0"/>
                                                                                            <GradientStop Color="#B45309" Offset="1.0"/>
                                                                                        </LinearGradientBrush>
                                                                                    </Path.Fill>
                                                                                </Path>
                                                                                <!-- Front Folder Body -->
                                                                                <Path Data="M 0.5 5 C 0.5 4.3 1.2 3.8 2.2 3.8 L 19.8 3.8 C 20.8 3.8 21.5 4.3 21.5 5 L 20.2 15 C 20 16 19.1 16.8 18 16.8 L 4 16.8 C 2.9 16.8 2 16 1.8 15 Z">
                                                                                    <Path.Fill>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                            <GradientStop Color="#FBBF24" Offset="0.0"/>
                                                                                            <GradientStop Color="#F59E0B" Offset="1.0"/>
                                                                                        </LinearGradientBrush>
                                                                                    </Path.Fill>
                                                                                </Path>
                                                                                <!-- Highlight Edge -->
                                                                                <Path Data="M 1 4.5 L 21 4.5 L 20.6 6.5 L 1.4 6.5 Z" Fill="#FFFFFF" Opacity="0.25"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       Style="{StaticResource FluxBodyMd}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- LAST MODIFIED Column -->
                            <GridViewColumn Width="240">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="LAST MODIFIED" Style="{StaticResource FluxColumnHeader}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedDateStr}" Style="{StaticResource FluxBodySm}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- SIZE Column -->
                            <GridViewColumn Width="140">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="SIZE" Style="{StaticResource FluxColumnHeader}"
                                                          HorizontalContentAlignment="Right"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedSize}" Style="{StaticResource FluxBodySm}"
                                                   HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- NO DEVICE CONNECTED EMPTY STATE -->
                <Border x:Name="PnlNoDevice" Visibility="Collapsed"
                        Background="{StaticResource FluxSurfaceContainerLowest}"
                        BorderBrush="{StaticResource FluxOutlineVariant}" BorderThickness="1"
                        CornerRadius="{StaticResource FluxRadiusLg}"
                        Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="28" Effect="{StaticResource FluxShadowLevel2}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="72" Height="72" Background="{StaticResource FluxSurfaceContainer}"
                                CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔌" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="22" Height="22" Background="{StaticResource FluxError}" CornerRadius="11"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                                    <TextBlock Text="⚡" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="No Device Connected" Style="{StaticResource FluxHeadlineMd}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Connect your device via USB and make sure it's unlocked with File Transfer mode enabled."
                                   Style="{StaticResource FluxBodySm}" Foreground="{StaticResource FluxOnSurfaceVariant}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Button Content="🔄 Try Again" Click="BtnRefreshDevice_Click"
                                Style="{StaticResource FluxPrimaryButton}" Height="38" Margin="0,0,0,10"/>

                        <Button Content="View Troubleshooting Guide" Click="BtnTroubleshoot_Click"
                                Style="{StaticResource FluxGhostButton}" Height="36" Margin="0,0,0,20"/>

                        <Border Background="{StaticResource FluxSurfaceContainerLow}" CornerRadius="{StaticResource FluxRadius}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="Tip: If your device isn't showing up, try a different USB port or original manufacturer cable."
                                           Style="{StaticResource FluxBodySm}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource FluxOnSurfaceVariant}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. IN-APP SETTINGS VIEW OVERLAY -->
            <Grid x:Name="PnlSettingsView" Visibility="Collapsed" Background="{StaticResource FluxSurface}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- SETTINGS TOP BAR -->
                    <Border Grid.Row="0" Margin="0,0,0,12" Padding="4,0,4,8" BorderBrush="{StaticResource FluxOutlineVariant}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="← Back to Files" Click="BtnHideSettings_Click"
                                        Style="{StaticResource FluxGhostButton}" Padding="10,6" Margin="0,0,16,0"/>
                                <TextBlock Text="⚙️  Application Settings" Style="{StaticResource FluxHeadlineMd}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SETTINGS MAIN BODY (SIDEBAR + CONTENT) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SIDEBAR CATEGORY MENU -->
                        <Border Grid.Column="0" Background="{StaticResource FluxSurfaceContainerLow}"
                                CornerRadius="8" Margin="0,0,12,0" Padding="6">
                            <StackPanel x:Name="PnlCategoryMenu">
                                <Button x:Name="TabGeneral" Content="⚙️  General" Click="TabButton_Click" Tag="0"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabAppearance" Content="🎨  Appearance" Click="TabButton_Click" Tag="1"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabTransfers" Content="🚀  Transfers" Click="TabButton_Click" Tag="2"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabDevice" Content="📱  Device" Click="TabButton_Click" Tag="3"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabExplorer" Content="📁  Explorer" Click="TabButton_Click" Tag="4"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabAdvanced" Content="🛠️  Advanced" Click="TabButton_Click" Tag="5"
                                        Style="{StaticResource SettingsTabButton}"/>
                                <Button x:Name="TabAbout" Content="ℹ️  About" Click="TabButton_Click" Tag="6"
                                        Style="{StaticResource SettingsTabButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT CONTENT PANELS -->
                        <Border Grid.Column="1" Background="{StaticResource FluxSurfaceContainerLowest}"
                                CornerRadius="8" BorderBrush="{StaticResource FluxOutlineVariant}" BorderThickness="1" Padding="20">
                            <Grid>
                                <!-- 0. GENERAL PANEL -->
                                <ScrollViewer x:Name="PnlGeneral" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Startup &amp; Background Behavior" Style="{StaticResource FluxTitleMd}" Margin="0,0,0,12"/>
                                        <CheckBox x:Name="ChkLaunchStartup" Content="Launch at Windows startup" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkMinimizeTray" Content="Minimize to system tray on close" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkAutoDetect" Content="Auto detect Android USB devices" IsChecked="True" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkAutoReconnect" Content="Auto reconnect device when plugged in" IsChecked="True" Margin="0,0,0,10"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 1. APPEARANCE PANEL -->
                                <ScrollViewer x:Name="PnlAppearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Theme Preferences" Style="{StaticResource FluxTitleMd}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Application Theme:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbTheme" SelectedIndex="0" Margin="0,0,0,16" Padding="8,4">
                                            <ComboBoxItem Content="System Default"/>
                                            <ComboBoxItem Content="Light Theme"/>
                                            <ComboBoxItem Content="Dark Theme"/>
                                        </ComboBox>

                                        <TextBlock Text="Language:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbLanguage" SelectedIndex="0" Margin="0,0,0,16" Padding="8,4">
                                            <ComboBoxItem Content="English"/>
                                            <ComboBoxItem Content="Malayalam (Future)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 2. TRANSFERS PANEL -->
                                <ScrollViewer x:Name="PnlTransfers" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="File Transfer &amp; Conflict Policies" Style="{StaticResource FluxTitleMd}" Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="Conflict Resolution (When File Exists):" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbConflict" SelectedIndex="1" Margin="0,0,0,14" Padding="8,4">
                                            <ComboBoxItem Content="Ask Every Time"/>
                                            <ComboBoxItem Content="Skip Existing (Default)"/>
                                            <ComboBoxItem Content="Replace Existing"/>
                                            <ComboBoxItem Content="Rename Automatically"/>
                                        </ComboBox>

                                        <TextBlock Text="File Compare Method:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbCompareMethod" SelectedIndex="1" Margin="0,0,0,14" Padding="8,4">
                                            <ComboBoxItem Content="Filename Only"/>
                                            <ComboBoxItem Content="Filename + Size (Default)"/>
                                            <ComboBoxItem Content="Filename + Size + Modified Date"/>
                                        </ComboBox>

                                        <TextBlock Text="Transfer Performance Mode:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbTransferMode" SelectedIndex="1" Margin="0,0,0,14" Padding="8,4">
                                            <ComboBoxItem Content="Maximum Speed"/>
                                            <ComboBoxItem Content="Balanced (Default)"/>
                                            <ComboBoxItem Content="Maximum Compatibility"/>
                                        </ComboBox>

                                        <TextBlock Text="Buffer Size:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbBufferSize" SelectedIndex="0" Margin="0,0,0,14" Padding="8,4">
                                            <ComboBoxItem Content="Auto (Recommended)"/>
                                            <ComboBoxItem Content="512 KB"/>
                                            <ComboBoxItem Content="1 MB"/>
                                            <ComboBoxItem Content="2 MB"/>
                                            <ComboBoxItem Content="4 MB"/>
                                            <ComboBoxItem Content="8 MB"/>
                                        </ComboBox>

                                        <CheckBox x:Name="ChkVerifyCopied" Content="Verify copied files after transfer" IsChecked="True" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="ChkRetryFailed" Content="Retry failed transfers automatically" IsChecked="True" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Retry Count:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox x:Name="CmbRetryCount" SelectedIndex="1" Width="80" Padding="6,2">
                                                <ComboBoxItem Content="1"/>
                                                <ComboBoxItem Content="3"/>
                                                <ComboBoxItem Content="5"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 3. DEVICE PANEL -->
                                <ScrollViewer x:Name="PnlDevice" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Device &amp; Storage Preferences" Style="{StaticResource FluxTitleMd}" Margin="0,0,0,12"/>

                                        <TextBlock Text="Default Storage Location:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbDefaultStorage" SelectedIndex="0" Margin="0,0,0,16" Padding="8,4">
                                            <ComboBoxItem Content="Internal Storage (/sdcard)"/>
                                            <ComboBoxItem Content="SD Card"/>
                                        </ComboBox>

                                        <TextBlock Text="Auto Refresh Device Polling Interval:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbRefreshInterval" SelectedIndex="1" Margin="0,0,0,16" Padding="8,4">
                                            <ComboBoxItem Content="1 sec"/>
                                            <ComboBoxItem Content="3 sec (Default)"/>
                                            <ComboBoxItem Content="5 sec"/>
                                        </ComboBox>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 4. EXPLORER PANEL -->
                                <ScrollViewer x:Name="PnlExplorer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="File Explorer Preferences" Style="{StaticResource FluxTitleMd}" Margin="0,0,0,12"/>

                                        <TextBlock Text="Default Startup View:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbDefaultView" SelectedIndex="0" Margin="0,0,0,14" Padding="8,4">
                                            <ComboBoxItem Content="Details (List View)"/>
                                            <ComboBoxItem Content="Large Icons (Grid View)"/>
                                        </ComboBox>

                                        <CheckBox x:Name="ChkShowHidden" Content="Show hidden files and folders" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="ChkShowExtensions" Content="Show file extensions" IsChecked="True" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="ChkShowFolderSizes" Content="Show folder sizes (slower)" Margin="0,0,0,14"/>

                                        <TextBlock Text="Copy Behavior:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkPreserveDate" Content="Preserve modified date" IsChecked="True" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkPreserveStructure" Content="Preserve folder structure" IsChecked="True" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkCreateMissing" Content="Create missing folders automatically" IsChecked="True" Margin="0,0,0,6"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 5. ADVANCED PANEL -->
                                <ScrollViewer x:Name="PnlAdvanced" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Advanced ADB Configuration" Style="{StaticResource FluxTitleMd}" Margin="0,0,0,12"/>

                                        <TextBlock Text="ADB Executable Path:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtCustomAdbPath" Padding="8,6" FontSize="12"/>
                                            <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseAdb_Click" Margin="8,0,0,0" Padding="12,4" Style="{StaticResource FluxGhostButton}"/>
                                        </Grid>

                                        <TextBlock Text="ADB Operation Timeout:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbAdbTimeout" SelectedIndex="0" Margin="0,0,0,14" Padding="8,4">
                                            <ComboBoxItem Content="30 sec (Default)"/>
                                            <ComboBoxItem Content="60 sec"/>
                                            <ComboBoxItem Content="120 sec"/>
                                        </ComboBox>

                                        <CheckBox x:Name="ChkDebugLogging" Content="Enable Debug Logging" Margin="0,0,0,6"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 6. ABOUT PANEL -->
                                <ScrollViewer x:Name="PnlAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Image Source="Assets/logo.png" Width="48" Height="48" Margin="0,0,12,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Open Transfer" Style="{StaticResource FluxTitleMd}" FontWeight="Bold"/>
                                                <TextBlock Text="Native High-Speed Android USB File Transfer" Style="{StaticResource FluxBodySm}" Foreground="{StaticResource FluxOutline}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Background="{StaticResource FluxSurfaceContainerLow}" Padding="12" CornerRadius="6" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="Version: 1.2.0 (Release)" FontSize="12" Margin="0,0,0,4"/>
                                                <TextBlock Text="Build: 2026.07.31" FontSize="12" Margin="0,0,0,4"/>
                                                <TextBlock Text="ADB Binary: Platform Tools 34.0.5" FontSize="12"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="🔄 Check for Updates Now" Click="BtnCheckUpdates_Click" Padding="12,6" Style="{StaticResource FluxPrimaryButton}" Margin="0,0,10,0"/>
                                            <Button Content="📁 Open Logs Folder" Click="BtnOpenLogsFolder_Click" Padding="12,6" Style="{StaticResource FluxGhostButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- BOTTOM BUTTON BAR -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel" Click="BtnHideSettings_Click" Width="90" Height="32" Margin="0,0,10,0" Style="{StaticResource FluxGhostButton}"/>
                        <Button Content="Save Settings" Click="BtnSaveSettings_Click" Width="120" Height="32" Style="{StaticResource FluxPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- COLLAPSIBLE ACTIVITY LOG DRAWER -->
        <Border Grid.Row="3" x:Name="PnlActivityLogs" Visibility="Collapsed"
                Background="{StaticResource FluxSurfaceContainerLowest}"
                BorderBrush="{StaticResource FluxOutlineVariant}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="ACTIVITY LOGS" Style="{StaticResource FluxLabelMd}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📋 Copy" Click="BtnCopyLogs_Click" Foreground="{StaticResource FluxOnSurfaceVariant}"
                                Background="Transparent" BorderThickness="0"
                                FontFamily="Inter, Segoe UI, sans-serif" FontSize="12" Cursor="Hand" Margin="0,0,12,0"/>
                        <Button Content="🗑️ Clear" Click="BtnClearLogs_Click" Foreground="{StaticResource FluxOnSurfaceVariant}"
                                Background="Transparent" BorderThickness="0"
                                FontFamily="Inter, Segoe UI, sans-serif" FontSize="12" Cursor="Hand" Margin="0,0,12,0"/>
                        <Button Content="✕" Click="BtnToggleLogs_Click" Foreground="{StaticResource FluxOutline}"
                                Background="Transparent" BorderThickness="0"
                                FontFamily="Inter, Segoe UI, sans-serif" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <TextBox Grid.Row="1" x:Name="TxtLogConsole"
                         Background="{StaticResource FluxSurfaceContainerLow}"
                         Foreground="{StaticResource FluxOnSurfaceVariant}"
                         FontFamily="Consolas" FontSize="11"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         BorderThickness="1" BorderBrush="{StaticResource FluxOutlineVariant}" Padding="8"/>
            </Grid>
        </Border>

        <!-- BOTTOM STATUS FOOTER BAR (Matching Exact Target UI Screenshot) -->
        <Border Grid.Row="4" Background="#F8F9FA" BorderBrush="{StaticResource FluxOutlineVariant}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Status Indicators: 🟢 Connected | 15 Items | 1 Selected | Free 82.4 GB -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Connected Badge -->
                    <StackPanel Orientation="Horizontal" x:Name="PnlStatusConnected">
                        <TextBlock Text="🟢" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Connected" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="14" Fill="{StaticResource FluxOutlineVariant}" Margin="14,0"/>

                    <!-- Items Count -->
                    <TextBlock x:Name="TxtStatusFooter" Text="15 Items" FontSize="12" Foreground="{StaticResource FluxOnSurfaceVariant}" VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="14" Fill="{StaticResource FluxOutlineVariant}" Margin="14,0"/>

                    <!-- Selected Stats (Highlighted in Vibrant Primary Blue #005FB8) -->
                    <TextBlock x:Name="TxtSelectedStats" Text="1 Selected" FontSize="12" FontWeight="Bold" Foreground="{StaticResource FluxPrimaryContainer}" VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="14" Fill="{StaticResource FluxOutlineVariant}" Margin="14,0"/>

                    <!-- Free Storage Info (Clickable to open Disk Analyzer) -->
                    <Border Cursor="Hand" MouseDown="TxtFreeStorage_MouseDown"
                            ToolTip="Click to open Storage Space Analyzer" Padding="4,2"
                            Background="Transparent" CornerRadius="4">
                        <TextBlock x:Name="TxtFreeStorage" Text="Free --" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource FluxPrimaryContainer}"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Right Controls: Settings + Logs Button + Grid/List View Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FluxActionButton}" Click="BtnSettings_Click" Padding="8,4" Margin="0,0,10,0" ToolTip="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,6,0" Foreground="{StaticResource FluxOnSurfaceVariant}"/>
                            <TextBlock Text="Settings" Foreground="{StaticResource FluxOnSurface}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FluxActionButton}" Click="BtnToggleLogs_Click" Padding="8,4" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Margin="0,0,6,0" Foreground="{StaticResource FluxOnSurfaceVariant}"/>
                            <TextBlock Text="Logs" Foreground="{StaticResource FluxOnSurface}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <!-- View Toggle Group -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Grid View Icon -->
                        <Button x:Name="BtnGridView" Click="BtnGridView_Click" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,4,0" ToolTip="Grid View">
                            <Border x:Name="BdrGridView" Background="Transparent" CornerRadius="4" Padding="6,4">
                                <TextBlock x:Name="TxtGridViewIcon" Text="㗊" FontSize="14" Foreground="{StaticResource FluxOutline}" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- List View Icon (Active Blue Pill State by Default) -->
                        <Button x:Name="BtnListView" Click="BtnListView_Click" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="List View">
                            <Border x:Name="BdrListView" Background="{StaticResource FluxPrimaryContainer}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="TxtListViewIcon" Text=":=" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
